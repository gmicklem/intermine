<link rel="stylesheet" type="text/css" href="TEST_SERVICE_ROOT/vendor/js/intermine/im-tables/2.2.0-beta/main.sandboxed.css">
<link rel="stylesheet" type="text/css" href="TEST_SERVICE_ROOT/css/im-tables-fonts.css">
<script charset="UTF-8" type="text/javascript" src="TEST_SERVICE_ROOT/vendor/js/intermine/im-tables/2.2.0-beta/imtables.js"></script>
<!-- A place holder element in your page to hold the table -->
<div id="query-container">
 <p class="apology">
  Please be patient while the results of your query are retrieved.
 </p>
</div>
<script type="text/javascript">
  var service = {root: 'TEST_SERVICE_ROOT', token: null};
  var query = {"model":{"name":"genomic"},"select":["Gene.primaryIdentifier","Gene.secondaryIdentifier","Gene.symbol","Gene.name","Gene.organism.shortName"],"orderBy":[{"Gene.primaryIdentifier":"ASC"}],"where":[{"path":"Gene.organism.commonName","op":"NOT LIKE","code":"A","value":"D.*"}]};
  imtables.loadTable('#query-container', {start: 0, size: 25}, {service: service, query: query}).then(
    function (table) { console.log('Table loaded', table); },
    function (error) { console.error('Could not load table', error); }
  );
</script>
