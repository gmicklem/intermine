  var service = {root: 'TEST_SERVICE_ROOT', token: null};
  var query = {"model":{"name":"genomic"},"title":"All genes --> TaxonId","description":"For all genes, list the taxonIds available.  Used by webservice to construct links to other intermines.","select":["Gene.organism.shortName"],"name":"im_available_organisms","comment":"used for displaying links to other intermines","dataTypes":["java.lang.String"],"orderBy":[{"Gene.organism.shortName":"ASC"}],"where":[{"path":"Gene.primaryIdentifier","op":"=","code":"A","editable":true,"switchable":false,"switched":"LOCKED","value":"zen"}]};
