<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
 <suppress checks="EqualsHashCode" files="(AbstractConstraint|ConstraintSet|Constraint|InListConstraint|NotConstraint|SubQueryConstraint|Either)\.java"/>
 <suppress checks="[a-zA-Z0-9]*" files="(Command|CommandRunner|Commands|Config|Endpoint|MapListener|Names|Queries|Segment|ArrayFormatter|NameSpacedProperties|ObjectFormatter)\.java"/>
 <suppress checks="JavadocMethod" files="(RegistryResponse|Instance)\.java"/>
 <suppress checks="Header" files="(R2RML|R2RMLMappingProcess)\.java"/>
 <suppress checks="MissingDeprecated" files="\.java$" message="has parse error"/>
</suppressions>

